# Ignore Mac dstore files
.DS_Store
*/.DS_Store

# Ignore files generated by common IDEs
.vscode/

# Ignore Drupal's file directory
web/sites/*/files

# Ignore sensitive information
#/web/sites/*/settings.php
web/sites/*/settings.local.php
web/sites/default/default.services.yml
web/sites/default/services.local.yml
web/sites/default/default.settings.php
salt.txt
config/default/swfwmd_phpmailer_oauth2.settings.yml
/db.php

# Ignore sass cache directory
web/themes/custom/houndridgeb5/.sass-cache/
web/themes/custom/houndridgeb5/.sass-cache/
web/themes/custom/houndridgeb5/scss/style.css.map

# Ignore node directory for sass support
node_modules

# Ignore SimpleTest multi-site environment
web/sites/simpletest

# Ignore .env files as they are personal
/.env
/.editorconfig
/.gitattributes

# Ignore error reporting and performance config
/config/default/dblog.settings.yml
/config/default/system.performance.yml
